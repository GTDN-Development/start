{
  "name": "start",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @start/web run dev",
    "build": "turbo run build --continue=never",
    "start": "pnpm --filter @start/web run start",
    "email:dev": "pnpm --filter @start/web run email:dev",
    "lint": "turbo run lint --continue=never",
    "lint:fix": "pnpm --filter @start/web run lint:fix",
    "test": "turbo run test --continue=never",
    "test:watch": "pnpm --filter @start/web run test:watch",
    "test:e2e": "pnpm --filter @start/web run test:e2e",
    "test:e2e:ui": "pnpm --filter @start/web run test:e2e:ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck --continue=never",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm typecheck",
    "web:build": "pnpm --filter @start/web run build",
    "web:lint": "pnpm --filter @start/web run lint",
    "web:lint:fix": "pnpm --filter @start/web run lint:fix",
    "web:test": "pnpm --filter @start/web run test",
    "web:test:watch": "pnpm --filter @start/web run test:watch",
    "web:test:e2e": "pnpm --filter @start/web run test:e2e",
    "web:test:e2e:ui": "pnpm --filter @start/web run test:e2e:ui",
    "web:format": "pnpm --filter @start/web run format",
    "web:format:check": "pnpm --filter @start/web run format:check",
    "web:typecheck": "pnpm --filter @start/web run typecheck",
    "web:check": "pnpm --filter @start/web run check",
    "pocketbase:typegen": "pnpm --filter @start/web run pocketbase:typegen",
    "pocketbase:mailpit:apply": "pnpm --filter @start/pocketbase run mailpit:apply",
    "turbo": "turbo"
  },
  "devDependencies": {
    "prettier": "~3.7.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.9.5"
  }
}
