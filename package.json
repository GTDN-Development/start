{
  "name": "start",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:full": "pnpm local:up && pnpm dev",
    "dev:down": "pnpm local:down",
    "local:up": "node ./scripts/local-stack.mjs up",
    "local:down": "node ./scripts/local-stack.mjs down",
    "build": "turbo run build",
    "start": "pnpm --filter @start/web run start",
    "lint": "turbo run lint",
    "lint:fix": "pnpm --filter @start/web run lint:fix",
    "test": "turbo run test",
    "test:watch": "pnpm --filter @start/web run test:watch",
    "test:e2e": "node ./scripts/run-web-e2e.mjs",
    "test:e2e:ui": "node ./scripts/run-web-e2e.mjs --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "check": "pnpm format:check && pnpm lint && pnpm check-types",
    "pocketbase:typegen": "pnpm --filter @start/web run pocketbase:typegen",
    "pocketbase:mailpit:apply": "node ./scripts/local-stack.mjs apply-mailpit",
    "turbo": "turbo"
  },
  "devDependencies": {
    "prettier": "~3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.12"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.14"
    }
  }
}
