# Pocketbase
NEXT_PUBLIC_PB_URL="https://pocketbase-start-dev.up.railway.app/"

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAABoTApAdoBJeaARP"
TURNSTILE_SECRET_KEY="XYZ"

# Playwright
PLAYWRIGHT_MAILTRAP_API_TOKEN="XXX"
PLAYWRIGHT_MAILTRAP_INBOX_ID="4493130"
PLAYWRIGHT_MAILTRAP_ACCOUNT_ID="2662629"

# local only (dev tooling / typegen)
