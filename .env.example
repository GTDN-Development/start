# default env
# Copy to `.env` or `.env.local`.

# email
MAIL_HOST="127.0.0.1"
MAIL_PORT=465
EMAIL_SECURE=true
MAIL_USERNAME="hello@gtdn.online"
MAIL_PASSWORD="XYZ"
MAIL_FROM_ADDRESS="hello@gtdn.online"
MAIL_FROM_NAME="Start App (Dev)"

# Recipient for all inbound form submissions (Contact, Support, etc.)
