# default env
# Copy to `.env` or `.env.local`.

# email
MAIL_HOST="127.0.0.1"
MAIL_PORT=465
EMAIL_SECURE=true
MAIL_USERNAME="hello@gtdn.online"
MAIL_PASSWORD="XYZ"
MAIL_FROM_ADDRESS="hello@gtdn.online"
MAIL_FROM_NAME="Start App (Local Dev)"

# Recipient for all inbound form submissions (Contact, Support, etc.)
GENERAL_FORMS_RECIPIENT="hello@gtdn.online"

# Pocketbase
NEXT_PUBLIC_PB_URL="https://pocketbase-start-dev.up.railway.app/"
PB_URL="https://pocketbase-start-dev.up.railway.app/"
PB_APP_URL="http://localhost:3100"

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_ENABLED=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAABoTApAdoBJeaARP"
TURNSTILE_SECRET_KEY="XYZ"

# Cookie consent
NEXT_PUBLIC_COOKIE_CONSENT_ENABLED=true

# Mailpit / Playwright (dev/test only)
MAIL_TRANSPORT="smtp"
MAILPIT_BASE_URL="https://mailpit-start-dev.up.railway.app"
MAILPIT_UI_USERNAME="mailpit-ui"
MAILPIT_UI_PASSWORD="XYZ"
MAILPIT_SEND_API_USERNAME="mailpit-send"
MAILPIT_SEND_API_PASSWORD="XYZ"
PLAYWRIGHT_TEST_EMAIL="your.name@gmail.com"

# local only (dev tooling / typegen)
PB_SUPERUSER_EMAIL="hello@gtdn.online"
PB_SUPERUSER_PASSWORD="XYZ"
PB_MAIL_FROM_NAME="Support"
PB_MAIL_FROM_ADDRESS="hello@gtdn.online"

# third party scripts
# NEXT_PUBLIC_GA_ID="G-XYZ"
# NEXT_PUBLIC_GTM_ID="GTM-XYZ"
