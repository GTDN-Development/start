# testing overrides
# Copy to `.env.test`.
# `pnpm test:e2e` injects isolated local service URLs at runtime.
# Keep env names in sync with ../../turbo.json build.env when build-time usage changes.

# Internal Next -> PocketBase requests
START_INTERNAL_API_SECRET=local-internal-secret

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAABoTApAdoBJeaARP
TURNSTILE_SECRET_KEY=XYZ

# Cookie consent
NEXT_PUBLIC_COOKIE_CONSENT_ENABLED=false

# Organizations are enabled in examples; missing env disables them at runtime.
NEXT_PUBLIC_ORGANIZATIONS_ENABLED=true

# Playwright
GOTENBERG_BASE_URL=http://127.0.0.1:3031
PLAYWRIGHT_TEST_EMAIL=your.name@gmail.com
