# prod env
# Copy values into your production deployment environment.
# Keep env names in sync with ../../turbo.json build.env when build-time usage changes.

# Internal apps/web server -> PocketBase requests
WEB_INTERNAL_API_SECRET=XYZ

# Public runtime URLs
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_PB_URL=https://pocketbase-example-prod.up.railway.app

# PDF rendering
# Set API_ENABLE_BASIC_AUTH=true on the Gotenberg Railway service.
GOTENBERG_BASE_URL=https://gotenberg-example-prod.up.railway.app
GOTENBERG_API_BASIC_AUTH_USERNAME=gotenberg
GOTENBERG_API_BASIC_AUTH_PASSWORD=XYZ

# Cloudflare Turnstile
# Next.js verifies Turnstile server-side before calling PocketBase.
NEXT_PUBLIC_TURNSTILE_ENABLED=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAABoTApAdoBJeaARP
TURNSTILE_SECRET_KEY=XYZ

# Cookie consent
NEXT_PUBLIC_COOKIE_CONSENT_ENABLED=true

# Organizations are enabled in examples; missing env disables them at runtime.
NEXT_PUBLIC_ORGANIZATIONS_ENABLED=true

# third party scripts
NEXT_PUBLIC_GA_ID="G-XYZ"
