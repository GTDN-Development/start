# local env
# Copy to `.env.local`.
# `pnpm dev` reads this file directly.
# Keep env names in sync with ../../turbo.json build.env when build-time usage changes.

# email
MAIL_TRANSPORT=mailpit-api
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Start App (Local Dev)"

# MAIL_TRANSPORT=smtp # "smtp"/"mailpit-api"
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# EMAIL_SECURE=false
# MAIL_USERNAME=hello@example.com
# MAIL_PASSWORD="XYZ"
# MAIL_FROM_ADDRESS=hello@example.com
# MAIL_FROM_NAME="Start App (Local Dev)"

# Recipient for all inbound form submissions (Contact, Support, etc.)
GENERAL_FORMS_RECIPIENT=hello@example.com

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_ENABLED=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAABoTApAdoBJeaARP
TURNSTILE_SECRET_KEY=XYZ

# Cookie consent
NEXT_PUBLIC_COOKIE_CONSENT_ENABLED=true

# Organizations are enabled in examples; missing env disables them at runtime.
NEXT_PUBLIC_ORGANIZATIONS_ENABLED=true

# local runtime URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PB_URL=http://127.0.0.1:8090
MAILPIT_BASE_URL=http://127.0.0.1:8025
GOTENBERG_BASE_URL=http://127.0.0.1:3031
