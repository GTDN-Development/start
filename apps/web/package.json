    "babel-plugin-react-compiler": "^1.0.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.555.0",
    "next": "16.2.6",
    "next-intl": "^4.12.0",
    "next-themes": "npm:@teispace/next-themes@^0.4.2",
    "pocketbase": "^0.26.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "^2.17.4",
