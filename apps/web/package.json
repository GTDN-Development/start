    "babel-plugin-react-compiler": "^1.0.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "next-themes": "npm:@teispace/next-themes@^3.0.0",
    "pocketbase": "^0.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
