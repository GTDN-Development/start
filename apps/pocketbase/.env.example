# PocketBase env example
# Use as the baseline for local and deployed PocketBase environments.

PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me

# Internal apps/web server -> PocketBase requests. Must match the web app value.
WEB_INTERNAL_API_SECRET=change-me-internal-secret

# Custom app email recipient. SMTP and sender settings are stored in PocketBase settings.
GENERAL_FORMS_RECIPIENT=hello@example.com

# Local Mailpit apply script values. Production sender identity is configured in PocketBase settings.
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Start App"
