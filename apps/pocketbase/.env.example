# PocketBase env example
# Use the same shape for both local and deployed PocketBase environments.

PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me

# Internal Next -> PocketBase requests. Must match the web app value.
START_INTERNAL_API_SECRET=change-me-internal-secret

# Email delivery and form recipient. SMTP settings are stored in PocketBase settings.
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Start App"
GENERAL_FORMS_RECIPIENT=hello@example.com
